# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
wheels/

# The bundled diagnostic model is trained and cached at runtime/install
# time from _training_data.py -- never commit a stale one.
src/aksci/ai_core/*.joblib

# Virtual environments
.venv/
venv/
env/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Environment / secrets -- never commit an API key
.env
.env.*
